{
  "name": "offwork-buddy",
  "productName": "下班搭子",
  "version": "1.11.0",
  "description": "你的桌面下班伙伴",
  "author": "Offwork Buddy",
  "private": true,
  "main": "dist/main/index.cjs",
  "scripts": {
    "test": "node scripts/build-character-cards.mjs --check && vitest run",
    "typecheck": "tsc -p vendor/cubism-framework/tsconfig.json && tsc --noEmit",
    "build": "node scripts/build.mjs",
    "dev": "npm run build && electron .",
    "test:e2e": "playwright test",
    "dist": "npm run build && electron-builder --win nsis --x64",
    "chat:server": "node scripts/chat-server.mjs",
    "build:developer": "node scripts/build-developer.mjs",
    "dist:developer": "npm run build:developer && electron-builder --config electron-builder.developer.yml --win nsis --x64"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "45.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
